---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap nf">
    <span class="label">404</span>
    <h1 class="display">That one’s a <span class="ember">fumble.</span></h1>
    <p class="lede">The page you’re looking for doesn’t exist or has moved.</p>
    <div class="ctas">
      <a class="btn btn-primary" href="/">Back to home</a>
      <a class="btn btn-secondary" href="/support">Get support</a>
    </div>
  </div>
</Base>

<style>
  .nf { display: grid; gap: 24px; justify-items: start; padding-block: clamp(80px, 14vw, 160px); }
  .ember { color: var(--ember); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
